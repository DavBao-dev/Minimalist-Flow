# Streamlit Community Cloud -> App settings -> Secrets
# Keep credentials and DB credentials private. Never commit secrets.toml.

[credentials]
admin = "change-this-password"

# Recommended for Streamlit Community Cloud:
# create a Turso database and put its URL + token here.
[database]
url = "libsql://YOUR-DB-YOUR-ORG.turso.io"
auth_token = "YOUR_TURSO_AUTH_TOKEN"

# For local/VPS/Docker with SQLite instead, remove/comment the two lines above
# and optionally use:
# path = "/absolute/path/to/minimalist_flow.db"
